<Page
    x:Class="MediaPerch.Shell.Pages.GraphPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:MediaPerch.Shell.Canvas"
    mc:Ignorable="d">

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" Padding="24,16,24,8">
            <StackPanel Spacing="16">
                <InfoBar x:Name="Note" IsOpen="False" IsClosable="True" />

                <TextBlock Text="The shape it is in"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <!-- Fusion's look over a chain's semantics: §10 says why it is
                     a row and not a cloud. Every gesture on it ends as one
                     dsp or video_dsp value, rewritten by this page. -->
                <ScrollViewer HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <canvas:NodeCanvas x:Name="Shape" />
                </ScrollViewer>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Drag a module from the palette onto the canvas to add it to its chain, or onto a wire to put it there. Drag a wire from a node's output onto another node's input to move a stage. Drag a stage's input wire away to remove it, or select the stage and press Delete. The gear opens a node's settings." />

                <!-- §10's palette: every stage module this engine loaded, to
                     drag onto a chain. -->
                <TextBlock Text="Palette" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView x:Name="Palette"
                          CanDragItems="True"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          MaxHeight="280"
                          DragItemsStarting="OnPaletteDrag" />

                <Expander x:Name="ModulePanel" HorizontalAlignment="Stretch" Header="Every module">
                    <ItemsControl x:Name="ModuleRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas"
                                           TextWrapping="NoWrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- The page's commands, bottom right, the primary one last and
             accented: where Fluent puts the buttons that act on a page, and
             where a person who has just changed something looks for them. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Padding="24,12,24,16">
            <Button Content="Refresh" Click="OnRefresh" />
            <Button Content="Player settings…" Click="OnPlayerSettings" />
            <Button Content="Engine settings…" Click="OnEngineSettings" />
            <Button Content="Save settings" Style="{StaticResource AccentButtonStyle}"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Page>
