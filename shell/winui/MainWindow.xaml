<Window
    x:Class="MediaPerch.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Acrylic, behind everything including the title bar. The window's own
         chrome is drawn by the system over it; what this shell draws is the
         drag region below, the navigation, and a page. -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="Auto,*" PreviewKeyDown="OnKey">

        <!-- The title bar, extended into. Everything in it is drag region; the
             caption buttons are the system's and sit on top. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="48" ColumnDefinitions="Auto,Auto,*">
            <FontIcon Grid.Column="0" Glyph="&#xE768;" FontSize="14" Margin="16,0,8,0"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="MediaPerch"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ConnectionLine" Grid.Column="2" Margin="16,0,160,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="200"
                        SelectionChanged="OnNavigate"
                        ItemInvoked="OnInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NowItem" Content="Now playing" Tag="now">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Playlist" Tag="playlist">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Engine" Tag="graph">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- Not a page: invoking it reconnects. Where a person looks
                     when the line in the title bar says the engine is gone. -->
                <NavigationViewItem Content="Reconnect" Tag="reconnect"
                                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="Pages" />
        </NavigationView>
    </Grid>
</Window>
