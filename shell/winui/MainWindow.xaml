<Window
    x:Class="MediaPerch.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:MediaPerch.Shell.Canvas"
    mc:Ignorable="d">

    <Grid x:Name="Root" RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <!-- The connection, first and plainly, because a shell that cannot say
             whether the engine is running is a shell that looks broken when it
             is the engine that is not there. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <InfoBar x:Name="Connection"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Not connected"
                     Message="mediaperchd is not running, or is listening somewhere else."
                     HorizontalAlignment="Stretch" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock x:Name="TrackLine" Style="{StaticResource TitleTextBlockStyle}"
                           Text="Nothing is playing" TextWrapping="Wrap" />
                <TextBlock x:Name="FormatLine"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <TextBlock Text="The shape it is in"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <!-- Fusion's look over a chain's semantics: §10 says why it is
                     a row and not a cloud. `—check` prints the same answer as
                     text, which is how the wire stays checkable without looking
                     at anything. -->
                <ScrollViewer HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <canvas:NodeCanvas x:Name="Shape" />
                </ScrollViewer>

                <!-- One node's settings, opened by the button on it. Empty
                     until something is asked for. -->
                <StackPanel x:Name="NodePanel" Visibility="Collapsed" Spacing="6">
                    <TextBlock x:Name="NodeTitle"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ItemsControl x:Name="NodeRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="Refresh" Content="Refresh" Click="OnRefresh" />
            <Button x:Name="PlayPause" Content="Pause" Click="OnPlayPause" />
            <Button x:Name="StopButton" Content="Stop" Click="OnStop" />
        </StackPanel>
    </Grid>
</Window>
