# Build trees
/build/
/out/
/.vs/
/.cache/
CMakeUserPresets.json

# Compiler and tooling droppings
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
compile_commands.json

# Editors
*.swp
*~
.DS_Store

# What a local fuzz run generates. The seed corpus in fuzz/corpus/{wav,flac} is
# tracked; anything the fuzzer discovers is not, until somebody decides it is a
# regression worth keeping.
/fuzz/corpus/*_found/
crash-*
leak-*
timeout-*
