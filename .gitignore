# Build trees
/build/
/out/
/.vs/
/.cache/
CMakeUserPresets.json

# Compiler and tooling droppings
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
compile_commands.json

# Editors
*.swp
*~
.DS_Store

# What a local fuzz run generates. The seed corpus in fuzz/corpus/{wav,flac} is
# tracked; anything the fuzzer discovers is not, until somebody decides it is a
# regression worth keeping.
/fuzz/corpus/*_found/
crash-*
leak-*
timeout-*

# Cargo. The workspace in modules/ builds into the CMake build tree
# (CARGO_TARGET_DIR is set there), so these only catch a cargo run by hand.
# Cargo.lock is kept: the modules have no dependencies outside the tree, and the
# fuzz crate's lock pins libfuzzer-sys.
abi/probe_rust/target/
/modules/target/
/modules/codec/alac/fuzz/target/

# Python leaves these beside tools/ when a script imports another.
__pycache__/
*.pyc

# `hm_cross_test` writes its bitstream, its reference YUV and HM's own log
# beside the working directory it is run from, which is the repository root
# when ctest is run there. They are outputs, not fixtures.
hm_cross_*.log
hm_cross_*.yuv
hm_cross_*.265

# The shell's managed build output. `dotnet` puts it beside the project.
shell/winui/bin/
shell/winui/obj/
