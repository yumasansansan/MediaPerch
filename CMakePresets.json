{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ninja-msvc",
      "inherits": "base",
      "displayName": "Ninja + MSVC",
      "description": "Faster than the .sln, but run it from a developer prompt.",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "MEDIAPERCH_EXPECT_TOOLSET": "MSVC"
      }
    },
    {
      "name": "ninja-msvc-avx2",
      "inherits": "ninja-msvc",
      "displayName": "Ninja + MSVC, AVX2",
      "description": "The same build raised to x86-64-v3. Needs a Haswell or Zen and refuses to start without one; CI ships this beside the baseline so a person can pick.",
      "cacheVariables": {
        "MEDIAPERCH_ARCH": "avx2"
      }
    },
    {
      "name": "core-only",
      "inherits": "ninja-msvc",
      "displayName": "Engine and player alone",
      "description": "What CI builds to keep the portable half portable, and to keep the engine free of the player. No platform head, no modules. Ninja rather than the .sln so CI does not care which Visual Studio the runner has.",
      "cacheVariables": {
        "MEDIAPERCH_BUILD_PLATFORM": "OFF"
      }
    },
    {
      "name": "measure",
      "inherits": "ninja-msvc",
      "displayName": "Release, with the measuring apparatus kept",
      "description": "An optimised build that still has `compare` and `verify`, so the decode-quality check can run at Release speed rather than Debug speed.",
      "cacheVariables": {
        "MEDIAPERCH_DIAGNOSTICS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Clang, sanitized",
      "description": "The parsers under ASan and UBSan. Clang's GNU driver, like the fuzzers, and like them it builds the core and the modules without the Windows head.",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "MEDIAPERCH_EXPECT_TOOLSET": "Clang",
        "MEDIAPERCH_BUILD_PLATFORM": "OFF",
        "MEDIAPERCH_SANITIZE": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzzers (Clang + libFuzzer)",
      "description": "libFuzzer over every parser that reads somebody else's file. Uses the GNU-driver clang++ rather than clang-cl: CMake drives lld-link directly for clang-cl, so -fsanitize never reaches the link and the sanitizer runtimes come out undefined.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "MEDIAPERCH_EXPECT_TOOLSET": "Clang",
        "MEDIAPERCH_BUILD_FUZZERS": "ON",
        "MEDIAPERCH_BUILD_TESTS": "OFF",
        "MEDIAPERCH_BUILD_PLATFORM": "OFF"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-msvc",
      "configurePreset": "ninja-msvc"
    },
    {
      "name": "ninja-msvc-avx2",
      "configurePreset": "ninja-msvc-avx2"
    },
    {
      "name": "ninja-msvc-debug",
      "configurePreset": "ninja-msvc",
      "configuration": "Debug"
    },
    {
      "name": "ninja-msvc-release",
      "configurePreset": "ninja-msvc",
      "configuration": "Release"
    },
    {
      "name": "ninja-msvc-relwithdebinfo",
      "configurePreset": "ninja-msvc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "measure",
      "configurePreset": "measure",
      "configuration": "Release"
    },
    {
      "name": "core-only",
      "configurePreset": "core-only",
      "configuration": "Debug"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    }
  ],
  "testPresets": [
    {
      "name": "measure",
      "configurePreset": "measure",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ninja-msvc",
      "configurePreset": "ninja-msvc",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ninja-msvc-avx2",
      "configurePreset": "ninja-msvc-avx2",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ninja-msvc-release",
      "configurePreset": "ninja-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "core-only",
      "configurePreset": "core-only",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
