{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "llvm-tools",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "CC": "clang",
        "CXX": "clang++",
        "RC": "llvm-rc",
        "LDFLAGS": "-fuse-ld=lld"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_LINKER_TYPE": "LLD",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_AR": "llvm-ar",
        "CMAKE_RANLIB": "llvm-ranlib",
        "CMAKE_NM": "llvm-nm",
        "CMAKE_OBJCOPY": "llvm-objcopy",
        "CMAKE_OBJDUMP": "llvm-objdump",
        "CMAKE_STRIP": "llvm-strip",
        "CMAKE_DLLTOOL": "llvm-dlltool",
        "CMAKE_RC_COMPILER": "llvm-rc"
      }
    },
    {
      "name": "llvm",
      "inherits": "llvm-tools",
      "displayName": "Ninja + LLVM",
      "description": "Day to day: Clang, LLD and the LLVM tools, the MSVC STL as the C++ library on Windows. No developer prompt: Clang finds Visual Studio's STL and the Windows SDK by itself.",
      "generator": "Ninja Multi-Config"
    },
    {
      "name": "llvm-avx2",
      "inherits": "llvm",
      "displayName": "Ninja + LLVM, AVX2",
      "description": "The same build raised to x86-64-v3. Needs a Haswell or Zen and refuses to start without one; CI ships this beside the baseline so a person can pick.",
      "cacheVariables": {
        "MEDIAPERCH_ARCH": "avx2"
      }
    },
    {
      "name": "llvm-avx512",
      "inherits": "llvm",
      "displayName": "Ninja + LLVM, AVX-512",
      "description": "The same build raised to x86-64-v4, with 512-bit vectors. Needs Skylake-SP, Ice Lake, Sapphire Rapids, Zen 4 or later, and refuses to start without AVX-512.",
      "cacheVariables": {
        "MEDIAPERCH_ARCH": "avx512"
      }
    },
    {
      "name": "llvm-native",
      "inherits": "llvm",
      "displayName": "Ninja + LLVM, this machine",
      "description": "The same build for exactly the processor it is built on, with 512-bit vectors where it has AVX-512. For that machine alone: another may refuse to start it.",
      "cacheVariables": {
        "MEDIAPERCH_ARCH": "native"
      }
    },
    {
      "name": "core-only",
      "inherits": "llvm",
      "displayName": "Engine and player alone",
      "description": "What CI builds to keep the portable half portable, and to keep the engine free of the player. No platform head, no modules.",
      "cacheVariables": {
        "MEDIAPERCH_BUILD_PLATFORM": "OFF"
      }
    },
    {
      "name": "measure",
      "inherits": "llvm",
      "displayName": "Release, with the measuring apparatus kept",
      "description": "An optimised build that still has `compare` and `verify`, so the decode-quality check can run at Release speed rather than Debug speed.",
      "cacheVariables": {
        "MEDIAPERCH_DIAGNOSTICS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "llvm-tools",
      "displayName": "Clang, sanitized",
      "description": "The parsers under ASan and UBSan, without the Windows head.",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MEDIAPERCH_BUILD_PLATFORM": "OFF",
        "MEDIAPERCH_SANITIZE": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "llvm-tools",
      "displayName": "Fuzzers (Clang + libFuzzer)",
      "description": "libFuzzer over every parser that reads somebody else's file, with the static C runtime libFuzzer is built against.",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MEDIAPERCH_BUILD_FUZZERS": "ON",
        "MEDIAPERCH_BUILD_TESTS": "OFF",
        "MEDIAPERCH_BUILD_PLATFORM": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "llvm",
      "configurePreset": "llvm"
    },
    {
      "name": "llvm-avx2",
      "configurePreset": "llvm-avx2"
    },
    {
      "name": "llvm-avx512",
      "configurePreset": "llvm-avx512"
    },
    {
      "name": "llvm-native",
      "configurePreset": "llvm-native"
    },
    {
      "name": "llvm-debug",
      "configurePreset": "llvm",
      "configuration": "Debug"
    },
    {
      "name": "llvm-release",
      "configurePreset": "llvm",
      "configuration": "Release"
    },
    {
      "name": "llvm-relwithdebinfo",
      "configurePreset": "llvm",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "measure",
      "configurePreset": "measure",
      "configuration": "Release"
    },
    {
      "name": "core-only",
      "configurePreset": "core-only",
      "configuration": "Debug"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    }
  ],
  "testPresets": [
    {
      "name": "measure",
      "configurePreset": "measure",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "llvm",
      "configurePreset": "llvm",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "llvm-avx2",
      "configurePreset": "llvm-avx2",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "llvm-avx512",
      "configurePreset": "llvm-avx512",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "llvm-native",
      "configurePreset": "llvm-native",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "llvm-release",
      "configurePreset": "llvm",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "core-only",
      "configurePreset": "core-only",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
