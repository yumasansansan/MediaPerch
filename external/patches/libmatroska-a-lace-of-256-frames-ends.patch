-        // read the list of frame sizes
-        std::uint8_t Index;
+        // read the list of frame sizes; counted wider than FrameNum, as above
+        std::size_t Index;
         std::uint32_t FrameSize;
         std::uint32_t SizeRead;
         std::uint64_t SizeUnknown;
