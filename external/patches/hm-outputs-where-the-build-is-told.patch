   set( BBuildEnv_MINSIZEREL_POSTFIX     "-mr" )
   
   
+  # Where the lib and bin trees go: the source tree unless told otherwise,
+  # which a build of several configurations from one source tree needs.
+  if( NOT DEFINED BBuildEnv_OUTPUT_ROOT )
+    set( BBuildEnv_OUTPUT_ROOT "${CMAKE_SOURCE_DIR}" )
+  endif()
